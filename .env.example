# Copia este archivo a .env y cambia los valores. .env está en .gitignore: nunca se sube.

# Contraseña del usuario sa de SQL Server (mín. 8 caracteres con mayúsculas, minúsculas y números).
SQL_SA_PASSWORD=Cambia_Esto_123

# Clave para firmar los JWT: 32+ caracteres aleatorios.
JWT_SIGNING_KEY=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres

# Administrador inicial.
ADMIN_EMAIL=admin@liveauction.local
ADMIN_PASSWORD=Admin_Cambia_123

# Opcional: crea los postores demo ana@demo.local y luis@demo.local con esta contraseña.
DEMO_PASSWORD=Demo_Cambia_123
