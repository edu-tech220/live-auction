# Copy this file to .env and change the values. .env is in .gitignore: it is never committed.

# SQL Server sa password (min. 8 characters with upper case, lower case and digits).
SQL_SA_PASSWORD=Change_This_123

# JWT signing key: 32+ random characters.
JWT_SIGNING_KEY=change-this-to-a-random-key-of-at-least-32-characters

# Initial administrator.
ADMIN_EMAIL=admin@liveauction.local
ADMIN_PASSWORD=Admin_Change_123

# Optional: creates the demo bidders ana@demo.local and luis@demo.local with this password.
DEMO_PASSWORD=Demo_Change_123
